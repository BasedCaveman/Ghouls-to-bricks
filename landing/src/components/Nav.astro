---
import SkullMark from "./SkullMark.astro";
const APP_URL = "https://ghouls-to-bricks.vercel.app/";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true"><SkullMark /></span>
      <span>Ghouls to Bricks</span>
    </a>
    <a class="btn btn-primary nav-cta" href={APP_URL}>Build my Ghoul</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 800 1.05rem/1 system-ui, sans-serif;
    text-decoration: none;
    color: var(--bone);
  }

  .brand-mark {
    display: inline-flex;
    width: 22px;
    aspect-ratio: 1 / 1;
    color: var(--ghoul);
    flex: none;
  }

  .nav-cta {
    padding: 0.6em 1.1em;
    font-size: 0.9rem;
  }
</style>
