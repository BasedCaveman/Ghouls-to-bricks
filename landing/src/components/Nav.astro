---
const APP_URL = "/build/";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand brick-text" href="#top">BRICK my GHOUL</a>
    <a class="btn btn-primary nav-cta" href={APP_URL}>brick my ghoul</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding-block: 0.9rem;
  }

  .brand {
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .nav-cta {
    padding: 0.6em 1.1em;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
</style>
