---
import SkullMark from "./SkullMark.astro";
const APP_URL = "https://ghouls-to-bricks.vercel.app/";
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true"><SkullMark /></span>
      <span class="brand-text">brick_my_ghoul</span>
    </a>
    <a class="btn btn-primary nav-cta" href={APP_URL}>build my ghoul</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--bone);
  }

  .brand-text {
    font: 700 0.95rem/1 var(--mono);
    letter-spacing: 0.01em;
  }

  .brand-mark {
    display: inline-flex;
    width: 20px;
    aspect-ratio: 22 / 26;
    color: var(--ghoul);
    flex: none;
  }

  .nav-cta {
    padding: 0.6em 1.1em;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
</style>
