---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot-inner">
    <p>
      Unofficial fan project · Not affiliated with, sponsored or endorsed by
      the Based Ghouls project or the LEGO Group. LEGO® is a trademark of the
      LEGO Group.
    </p>
    <p>
      <a
        href="https://github.com/BasedCaveman/Ghouls-to-bricks"
        target="_blank"
        rel="noopener"
      >source</a>
      · built on the Ghouls to Bricks engine · made by pedr0x.eth · {year}
    </p>
  </div>
</footer>

<style>
  .foot {
    padding-block: 2.5rem;
    border-top: 1px solid var(--line);
    font: 0.75rem/1.6 var(--mono);
    color: var(--bone-dim);
  }

  .foot-inner {
    display: grid;
    gap: 0.5rem;
    text-align: center;
  }

  .foot a {
    color: var(--ghoul);
    text-decoration: none;
  }

  .foot a:hover {
    text-decoration: underline;
  }
</style>
