---
// Visual signature: the Brick My Ghoul skull mark, traced pixel-for-pixel from the
// reference artwork (22×26 grid), rendered as if it were built out of LEGO® plates — each
// grid cell gets a stud, echoing the app's own "1 pixel = 1 stud" logic. Purely decorative
// (aria-hidden). Used behind the hero, in the footer, on the favicon and as the nav mark.
//
// Astro's scoped styles don't reach elements rendered by a child component — so this SVG
// fills 100% of its container (width/height as static attributes, not a class) and whoever
// uses it controls size/position/opacity via a wrapper in their own file
// (see Hero.astro, CTAFinal.astro, Nav.astro). Each instance gets its own pattern id so
// several marks can sit in the same page without one's <defs> clobbering another's.
const uid = `studs-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  width="100%"
  height="100%"
  viewBox="0 0 22 26"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern id={uid} width="1" height="1" patternUnits="userSpaceOnUse">
      <rect width="1" height="1" fill="currentColor" />
      <circle cx="0.5" cy="0.5" r="0.3" fill="var(--bg, #000)" opacity="0.5" />
    </pattern>
  </defs>
  <g fill={`url(#${uid})`}>
    <rect x="6" y="0" width="9" height="1" />
    <rect x="4" y="1" width="13" height="1" />
    <rect x="2" y="2" width="16" height="1" />
    <rect x="1" y="3" width="19" height="1" />
