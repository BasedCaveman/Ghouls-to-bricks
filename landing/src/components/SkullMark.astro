---
// Visual signature: a pixel-skull outline, purely decorative (aria-hidden).
// Used as a recurring motif behind the hero and in the footer — reinforces the lore
// without relying on licensed Based Ghouls artwork.
//
// Astro's scoped styles don't reach elements rendered by a child component — so this SVG
// fills 100% of its container (width/height as static attributes, not a class) and whoever
// uses it controls size/position/opacity via a wrapper in their own file
// (see Hero.astro, CTAFinal.astro, Nav.astro).
---

<svg
  width="100%"
  height="100%"
  viewBox="0 0 32 32"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  <g fill="currentColor">
    <rect x="10" y="4" width="12" height="2" />
    <rect x="8" y="6" width="2" height="2" />
    <rect x="22" y="6" width="2" height="2" />
    <rect x="6" y="8" width="2" height="10" />
    <rect x="24" y="8" width="2" height="10" />
    <rect x="8" y="18" width="2" height="2" />
    <rect x="22" y="18" width="2" height="2" />
    <rect x="10" y="20" width="4" height="2" />
    <rect x="18" y="20" width="4" height="2" />
    <rect x="10" y="22" width="2" height="4" />
    <rect x="20" y="22" width="2" height="4" />
    <rect x="12" y="24" width="2" height="4" />
    <rect x="18" y="24" width="2" height="4" />
    <rect x="8" y="8" width="16" height="10" opacity="0.9" />
  </g>
  <g fill="var(--bg,#0b0d0a)">
    <rect x="11" y="11" width="3" height="4" />
    <rect x="18" y="11" width="3" height="4" />
    <rect x="15" y="15" width="2" height="2" />
    <rect x="12" y="18" width="8" height="1.5" />
  </g>
</svg>
