---
import { Image } from "astro:assets";
import SkullMark from "./SkullMark.astro";
import kitPreview from "../assets/hero-kit-preview.webp";
const APP_URL = "/build/";
---

<section id="top" class="hero">
  <div class="hero-mark" aria-hidden="true"><SkullMark /></div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">free · unofficial fan tool · 100% client-side</p>
      <h1 class="hero-title">
        Consumed as a jpeg.<br />
        <span class="accent">Brick my Ghoul<span class="caret" aria-hidden="true"></span></span>
      </h1>
      <p class="hero-sub">
        Drop your Based Ghoul in and watch it get reforged, stud by stud, into
        a brick model you can actually build. Real LEGO® colours, a
        step-by-step manual and a parts list ready to order — no wallet, no
        upload, no lookup.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={APP_URL}>./brick-my-ghoul</a>
        <a class="btn btn-ghost" href="#how">see how it works</a>
      </div>
      <p class="hero-note">
        Not affiliated with, sponsored or endorsed by the Based Ghouls
        project or the LEGO Group.
      </p>
    </div>
    <figure class="hero-proof">
      <span class="hero-proof-bar" aria-hidden="true">$ brick_my_ghoul --kit</span>
      <Image
        src={kitPreview}
        alt="A Ghoul skull rendered as a real brick kit: 2,148 pieces, 98 steps, 0 collisions, 0 floating pieces, about 51×10×52cm with backdrop."
        width={900}
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 6vw, 4rem) var(--space-section);
  }

  .hero-mark {
    position: absolute;
    inset: -6% 0 auto;
    width: min(38vw, 480px);
    aspect-ratio: 22 / 26;
    margin-inline: auto;
    color: var(--ghoul);
    opacity: 0.06;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    max-width: 76rem;
    text-align: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.6vw + 1rem, 4.4rem);
    line-height: 1.04;
  }

  .accent {
    color: var(--ghoul);
    font-family: var(--mono);
  }

  .hero-sub {
    font-size: clamp(1rem, 0.3vw + 0.95rem, 1.15rem);
    color: var(--bone-dim);
    max-width: 42ch;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .hero-note {
    font: 0.75rem/1.5 var(--mono);
    color: var(--bone-dim);
    opacity: 0.75;
    max-width: 36ch;
  }

  .hero-proof {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    box-shadow: 0 30px 70px -30px rgba(191, 64, 255, 0.35);
  }

  .hero-proof-bar {
    display: block;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font: 0.75rem/1 var(--mono);
    color: var(--ghoul);
    text-align: left;
  }

  .hero-proof img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 1000px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      text-align: left;
    }

    .hero-copy {
      justify-items: start;
    }

    .hero-cta,
    .hero-sub {
      justify-content: flex-start;
    }
  }
</style>
