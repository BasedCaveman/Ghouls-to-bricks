---
const APP_URL = "/build/";
---

<section class="cta">
  <div class="wrap cta-inner">
    <p class="cta-eyebrow brick-text">BRICK my GHOUL</p>
    <h2>Your Ghoul is waiting to be bricked.</h2>
    <p class="cta-sub">Free, instant, and it never leaves your browser.</p>
    <a class="btn btn-primary" href={APP_URL}>./brick-my-ghoul</a>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .cta-eyebrow {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .cta h2 {
    font-size: var(--h2);
    max-width: 24ch;
  }

  .cta-sub {
    font: 0.9375rem/1.5 var(--mono);
    color: var(--bone-dim);
    margin-bottom: 0.5rem;
  }
</style>
