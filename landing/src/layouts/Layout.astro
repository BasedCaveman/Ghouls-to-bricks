---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Brick My Ghoul — turn your Ghoul into real LEGO bricks",
  description = "Consumed as a jpeg. Summoned anew in ABS. Turn your Based Ghoul into a brick model you can really build: 3D build animation, PDF instructions and a BrickLink parts list. Free, and your image never leaves your browser.",
  ogImage = "/og.png",
} = Astro.props;

// Só emite canonical/OG absolutos quando `site` estiver definido no astro.config.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImageAbsolute = Astro.site
  ? new URL(ogImage, Astro.site)
  : ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
  </head>
  <body>
    <slot />
  </body>
</html>
